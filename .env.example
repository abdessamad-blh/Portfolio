# All optional. Copy to .env.local for local builds.
# On GitHub Pages these are set by .github/workflows/deploy.yml.

# Canonical site URL (no trailing slash), used for metadata, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://abdessamad-blh.github.io/Portfolio

# Sub-path the site is served under. "/Portfolio" on GitHub Pages; leave empty on a custom domain.
NEXT_PUBLIC_BASE_PATH=

# Umami analytics. The script is only added when the website ID is set.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
